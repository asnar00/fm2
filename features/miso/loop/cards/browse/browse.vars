# which of the two views the set is drawn in. Navigation, not world: it stays
# on the device that chose it, exactly as /tools' own open_tool does, and a
# device-scoped write queues no op.
view: String = "grid".to_string() (device, last-write, own)
# the card whose page is open; empty means the set. Device-scoped for the same
# reason — where you are is not what you own.
open: String = String::new() (device, last-write, own)
