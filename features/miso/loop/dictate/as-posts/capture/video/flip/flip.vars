# which camera a video is recorded with: "back" or "front". How you work, not
# what you own — device-scoped exactly as /one-add's `mode` is, and a
# device-scoped write queues no op. Bridged to the page half, which is where
# the camera is actually asked for.
facing: String = "back".to_string() (device, last-write, own) js:facing
