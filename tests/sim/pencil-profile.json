[
  {"note": "my profile from the people grid, then the pencil"},
  {"home": true},
  {"wait_for": "[ev=tool_account]"},
  {"tap": "[ev=tool_account]"},
  {"wait_for": ".card-tile"},
  {"tap": ".card-tile"},
  {"wait_for": "[ctl=card_edit]"},
  {"assert": {"find": "[ctl=card_edit]", "face": "edit"}, "name": "my profile opens locked, with the pencil"},
  {"tap": "[ctl=card_edit]"},
  {"wait": 1800},
  {"assert": {"find": ".card-page"}, "name": "after the pencil the card is still open"},
  {"assert": {"find": ".card-page .card-text", "ce": true}, "name": "after the pencil the words are editable"},
  {"js": "if (document.activeElement) document.activeElement.blur(); return 1"},
  {"wait": 900},
  {"tap": "[ctl=card_edit]"},
  {"wait": 600},
  {"home": true}
]
