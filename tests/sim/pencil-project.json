[
  {"note": "a project of my own, then the pencil"},
  {"home": true},
  {"wait_for": "[ev=tool_projects]"},
  {"tap": "[ev=tool_projects]"},
  {"wait": 1200},
  {"js": "const b = document.querySelector('[data-proj=new]'); if (!b) return 'no new'; b.click(); return 1", "expect": 1, "name": "new project (setup)"},
  {"wait_for": ".card-page"},
  {"js": "if (document.activeElement) document.activeElement.blur(); return 1"},
  {"wait": 900},
  {"tap": "[ctl=card_edit]"},
  {"wait": 900},
  {"assert": {"find": "[ctl=card_edit]", "face": "edit"}, "name": "the tick locked the project"},
  {"tap": "[ev=tool_projects]"},
  {"wait_for": ".card-tile"},
  {"js": "const t = [...document.querySelectorAll('.card-tile')]; return t.length"},
  {"tap": ".card-tile"},
  {"wait_for": ".card-page"},
  {"wait": 600},
  {"js": "return !!document.querySelector('[data-ctl=card_edit]')", "expect": true, "name": "the opened project is mine (pencil present)"},
  {"tap": "[ctl=card_edit]"},
  {"wait": 1800},
  {"assert": {"find": ".card-page"}, "name": "after the pencil the project is still open"},
  {"assert": {"find": ".card-page .card-text", "ce": true}, "name": "after the pencil the words are editable"},
  {"js": "if (document.activeElement) document.activeElement.blur(); return 1"},
  {"wait": 900},
  {"tap": "[ctl=card_edit]"},
  {"wait": 600},
  {"home": true}
]
